OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
CHROMA_DIR=./chroma_db
COLLECTION_NAME=travel-sense-docs

# Firebase Admin credentials for verifying ID tokens. Set one of the two
# service-account options below (path is preferred for deploys; the inline
# JSON blob is convenient for local dev).
FIREBASE_PROJECT_ID=
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# Optional: the Firebase UID that owns backend/data/personal/*.md. Leave
# unset to exclude that legacy personal data from retrieval entirely.
LEGACY_PERSONAL_OWNER_USER_ID=
